@startuml casos-de-uso
title BarrioAlerta — Diagrama general de casos de uso (v0)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visitante" as Visitante
actor "Vecino" as Vecino
actor "Operador municipal" as Operador
actor "Miembro de cuadrilla" as Cuadrilla
actor "Administrador" as Admin
actor "Reloj del sistema" as Reloj <<sistema>>
actor "Georef API" as Georef <<sistema externo>>

Visitante <|-- Vecino

rectangle "BarrioAlerta" {
  package "Acceso" {
    usecase "Ver mapa público" as UC_Mapa
    usecase "Registrarse" as UC_Registro
    usecase "Autenticarse" as UC_Login
  }

  package "Incidentes (vecino)" {
    usecase "Reportar incidente" as UC_Reportar
    usecase "Ver duplicados cercanos" as UC_VerDup
    usecase "Adherir a incidente" as UC_Adherir
    usecase "Consultar mis reportes\ny su historial" as UC_MisReportes
    usecase "Confirmar resolución" as UC_Cerrar
    usecase "Reabrir incidente" as UC_Reabrir
    usecase "Elegir canal de notificación" as UC_Canal
  }

  package "Gestión (operador)" {
    usecase "Validar / rechazar incidente" as UC_Validar
    usecase "Marcar duplicado" as UC_MarcarDup
    usecase "Consultar ranking de prioridad" as UC_Ranking
    usecase "Asignar cuadrilla" as UC_Asignar
    usecase "Consultar propuestas\nde asignación" as UC_Propuestas
  }

  package "Trabajo de campo (cuadrilla)" {
    usecase "Consultar mis tareas" as UC_Tareas
    usecase "Iniciar trabajo" as UC_Iniciar
    usecase "Resolver con evidencia" as UC_Resolver
  }

  package "Administración" {
    usecase "Configurar tipos y SLA" as UC_Tipos
    usecase "Configurar pesos de priorización" as UC_Pesos
    usecase "Gestionar cuadrillas" as UC_Cuadrillas
    usecase "Importar históricos CSV" as UC_Importar
    usecase "Avanzar reloj de demo" as UC_RelojDemo
  }

  package "Procesos automáticos" {
    usecase "Escalar incidentes\ncon SLA vencido" as UC_Escalar
    usecase "Cerrar resueltos\nsin reapertura (72 h)" as UC_AutoCierre
    usecase "Notificar interesados" as UC_Notificar
    usecase "Resolver dirección y barrio" as UC_Geo
  }
}

Visitante --> UC_Mapa
Visitante --> UC_Registro
Vecino --> UC_Reportar
Vecino --> UC_Adherir
Vecino --> UC_MisReportes
Vecino --> UC_Cerrar
Vecino --> UC_Reabrir
Vecino --> UC_Canal

Operador --> UC_Validar
Operador --> UC_MarcarDup
Operador --> UC_Ranking
Operador --> UC_Asignar

Cuadrilla --> UC_Tareas
Cuadrilla --> UC_Iniciar
Cuadrilla --> UC_Resolver

Admin --> UC_Tipos
Admin --> UC_Pesos
Admin --> UC_Cuadrillas
Admin --> UC_Importar
Admin --> UC_RelojDemo

Reloj --> UC_Escalar
Reloj --> UC_AutoCierre

UC_Reportar ..> UC_Login : <<include>>
UC_Asignar ..> UC_Login : <<include>>
UC_Resolver ..> UC_Login : <<include>>
UC_Tipos ..> UC_Login : <<include>>
UC_Reportar ..> UC_VerDup : <<include>>
UC_Reportar ..> UC_Geo : <<include>>
UC_Adherir .> UC_VerDup : <<extend>>
UC_Asignar ..> UC_Propuestas : <<include>>
UC_Escalar ..> UC_Notificar : <<include>>
UC_Asignar ..> UC_Notificar : <<include>>
UC_Resolver ..> UC_Notificar : <<include>>
UC_Geo --> Georef
@enduml
