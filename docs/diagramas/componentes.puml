@startuml componentes
title BarrioAlerta — Diagrama de componentes (C4 nivel 3, v0)
skinparam componentStyle uml2

node "Navegador" {
  [SPA React] as SPA
}

package "Backend Spring Boot (monolito modular)" {
  [API REST\n(controllers + ManejadorDeErrores)] as API
  interface "HTTP/JSON" as HTTP
  API - HTTP

  [Identidad\n(JWT, Usuario/Rol/Permiso)] as Identidad
  [Incidentes\n(agregado, estados, priorización, cuadrillas)] as Incidentes
  [Asignación\n(estrategias)] as Asignacion
  [Notificaciones\n(Facade, canales, factory)] as Notificaciones
  [Importación CSV\n(Template Method)] as Importacion
  [Geo\n(adaptadores)] as Geo
  [Planificador\n(ControlDeSlaJob, cierre 72 h)] as Planificador
  [Demo\n(RelojDeDemo, reset)] as Demo
  [Repositorios JPA] as Repos

  interface "Geocodificador" as PuertoGeo
  interface "EstrategiaAsignacion" as PuertoAsignacion
  interface "Eventos de dominio" as Eventos
  interface "Clock" as Reloj

  Incidentes -- PuertoGeo
  Geo ..> PuertoGeo : implementa
  Asignacion -- PuertoAsignacion
  Incidentes -- Eventos
  Notificaciones ..> Eventos : escucha (async)
  Demo -- Reloj
  Planificador ..> Reloj
  Incidentes ..> Reloj

  API ..> Identidad
  API ..> Incidentes
  API ..> Asignacion
  API ..> Importacion
  API ..> Demo
  Asignacion ..> Incidentes
  Importacion ..> Incidentes
  Planificador ..> Incidentes
  Incidentes ..> Identidad
  Incidentes ..> Repos
  Notificaciones ..> Repos
  Identidad ..> Repos
}

database "PostgreSQL 16" as DB
folder "Fotos\n(./data/fotos)" as Fotos
cloud "Georef API\n(apis.datos.gob.ar)" as Georef

SPA ..> HTTP
Repos ..> DB : JDBC
Incidentes ..> Fotos
Geo ..> Georef : HTTPS (solo fuera de la demo)

note bottom of Asignacion
  Las dependencias entre módulos van en un solo sentido
  (sin ciclos): lo verifica ArquitecturaTest (ArchUnit).
end note
@enduml
