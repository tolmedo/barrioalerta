@startuml componentes
title BarrioAlerta — Diagrama de componentes (v0)
skinparam componentStyle uml2

node "Navegador" {
  [SPA React] as SPA
}

package "Backend Node + Express (aplicación multimódulo)" {
  [API REST\n(rutas + manejadorDeErrores)] as API
  interface "HTTP/JSON" as HTTP
  API - HTTP

  [Identidad\n(Usuario/Rol/Permiso, tokens)] as Identidad
  [Incidentes\n(agregado, estados, cuadrillas)] as Incidentes
  [Asignación\n(estrategias)] as Asignacion
  [Notificaciones\n(Facade, canales simulados)] as Notificaciones
  [Importación CSV\n(Template Method)] as Importacion
  [Tarea programada\n(control de SLA)] as Planificador
  [Demo\n(RelojDeDemo)] as Demo
  [Repositorios\n(ORM)] as Repos

  interface "EstrategiaAsignacion" as PuertoAsignacion
  interface "Eventos de dominio" as Eventos
  interface "Reloj" as Reloj

  Asignacion -- PuertoAsignacion
  Incidentes -- Eventos
  Notificaciones ..> Eventos : se suscribe
  Demo -- Reloj
  Planificador ..> Reloj

  API ..> Identidad
  API ..> Incidentes
  API ..> Asignacion
  API ..> Importacion
  Asignacion ..> Incidentes
  Importacion ..> Identidad
  Planificador ..> Incidentes
  Incidentes ..> Identidad
  Incidentes ..> Repos
  Identidad ..> Repos
}

database "PostgreSQL 16" as DB
database "MongoDB 8\n(notificaciones)" as Mongo
folder "Fotos\n(./data/fotos)" as Fotos

SPA ..> HTTP
Repos ..> DB : ORM
Notificaciones ..> Mongo : ODM (Mongoose)
Incidentes ..> Fotos

note bottom of Asignacion
  Las dependencias entre módulos van en un solo sentido
  (sin ciclos): Asignación conoce a Incidentes, nunca al revés.
end note
@enduml
