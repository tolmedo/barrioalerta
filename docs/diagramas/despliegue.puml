@startuml despliegue
title BarrioAlerta — Despliegue (demo local)

node "Notebook 1 (principal)" <<device>> {
  node "Windows 11" <<os>> {
    node "Navegador (perfil limpio)" <<execution environment>> {
      artifact "SPA React (build estático)" as SPA1
    }
    node "Node.js 22" <<execution environment>> {
      artifact "backend (Express, modo demo,\nsirve también la SPA)" as API1
    }
    database "PostgreSQL 16" as DB1
    database "MongoDB 8" as Mongo1
    folder "data/fotos" as Archivos1
  }
}

node "Notebook 2 (plan B)" <<device>> {
  artifact "mismo tag v1.0-demo\n+ mismo seed" as Espejo
}

node "Proyector" <<device>> as Proyector

SPA1 --> API1 : HTTP :8080 (mismo origen)
API1 --> DB1 : TCP :5432
API1 --> Mongo1 : TCP :27017
API1 --> Archivos1 : lectura/escritura
Proyector -- "Notebook 1 (principal)" : HDMI
note right of Espejo
  Sin red entre notebooks:
  el cambio es de cable HDMI (< 30 s).
  Nada requiere internet.
end note
@enduml
